{
  "name": "prebid.github.io",
  "version": "1.0.0",
  "description": "This repository contains the source files for the Prebid.js documentation site at [Prebid.org](https://prebid.org).",
  "main": "index.js",
  "directories": {
    "example": "examples",
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtreNet/prebid.github.io.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AtreNet/prebid.github.io/issues"
  },
  "homepage": "https://github.com/AtreNet/prebid.github.io#readme",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc --noEmit",
    "verify:toolchain": "node scripts/validate-toolchain.mjs",
    "verify:dependencies": "npm ls --all",
    "test:migration": "node --test scripts/migration-*.test.mjs scripts/validate-*.test.mjs",
    "validate:content": "node scripts/validate-authored-content.mjs",
    "validate:site": "node scripts/validate-site.mjs",
    "validate": "npm run verify:toolchain && npm run verify:dependencies && npm run typecheck && npm run test:migration && npm run validate:site"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.4",
    "react-dom": "^19.0.4"
  },
  "devDependencies": {
    "@11ty/gray-matter": "1.0.0",
    "@docusaurus/mdx-loader": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/plugin-content-pages": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@docusaurus/utils": "3.10.2",
    "@docusaurus/utils-validation": "3.10.2",
    "@noble/hashes": "1.8.0",
    "cheerio": "1.0.0-rc.12",
    "js-yaml": "4.3.2",
    "jsdom": "30.1.2",
    "liquidjs": "10.30.0",
    "remark-directive": "3.0.1",
    "remark-gfm": "4.0.1",
    "remark-lint-fenced-code-flag": "4.2.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "typescript": "^5.9.3",
    "unified": "11.0.5"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0"
}
